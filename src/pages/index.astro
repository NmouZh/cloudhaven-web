---
import BaseLayout from '../layouts/BaseLayout.astro';

const activities = [
  {
    index: '01',
    title: '共同建造',
    text: '从选址到落成，图纸和材料都摊在公共仓库里，谁有空谁来搭一手。',
    meta: '长期',
  },
  {
    index: '02',
    title: '生存与探索',
    text: '开荒、下矿、跑图。危险的地方不单独去，缺什么在群里喊一声。',
    meta: '日常',
  },
  {
    index: '03',
    title: '公共设施',
    text: '刷怪塔、农田、交通线归大家用，也归大家维护；坏了就修，不追究。',
    meta: '共享',
  },
  {
    index: '04',
    title: '社区活动',
    text: '建筑比赛、节日活动、语音夜谈。不强制参加，想来就来。',
    meta: '不定期',
  },
];

const rules = [
  {
    index: '01',
    title: '不动别人的东西',
    text: '建筑、箱子、农田都算私人领地。要用先问，借了要还。',
  },
  {
    index: '02',
    title: '公共仓库取用登记',
    text: '急用可以直接拿，事后在告示牌上写一笔，方便下一个人补货。',
  },
  {
    index: '03',
    title: '冲突先沟通',
    text: '选址重叠、风格不合，先私聊；谈不拢再找管理员，不拆不炸。',
  },
  {
    index: '04',
    title: '长期不上线说一声',
    text: '生活优先。离开一阵子打个招呼，位置和东西都给你留着。',
  },
  {
    index: '05',
    title: '对外代表组织',
    text: '在服务器里挂著云栖深处的名字，就别做让邻居为难的事。',
  },
];
---

<BaseLayout
  title="云栖深处 · CloudHaven"
  description="云栖深处（CloudHaven）是一群玩家在 Minecraft 服务器上共同经营的组织：一起建造、探索，把一处地方住成家。"
>
  <div class="hw-shell page-shell">
    <header class="page-head enter">
      <div class="page-head-copy">
        <p class="hw-eyebrow">我的世界 · 玩家组织</p>
        <h1>云栖深处</h1>
        <p class="page-head-sub">
          一群玩家在 Minecraft 服务器上共同经营的地方。慢一点，把一处角落住成家。
        </p>
      </div>
      <div class="page-head-actions">
        <button
          class="icon-button"
          type="button"
          data-theme-toggle
          aria-label="切换到深色模式"
          aria-pressed="false"
        >
          <svg
            class="theme-icon-moon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
          </svg>
          <svg
            class="theme-icon-sun"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </div>
    </header>

    <section class="hero-plate enter" aria-labelledby="hero-title">
      <div>
        <p class="hero-en">CloudHaven · Minecraft</p>
        <h2 class="hero-title" id="hero-title">把一处地方，住成家</h2>
        <p class="hero-lead">
          我们一起选址、修路、盖房，也一起下矿、打怪、过节。没有考核，只有几条说好的约定。
        </p>
        <div class="hero-actions">
          <a class="filled-button" href="#join">申请加入</a>
          <a class="outlined-button hero-chip" href="#rules">看看约定</a>
        </div>
        <div class="hero-tags">
          <span class="assist-chip hero-chip">长期经营</span>
          <span class="assist-chip hero-chip">合作建造</span>
          <span class="assist-chip hero-chip">人少一点</span>
        </div>
      </div>
    </section>

    <section class="section" id="activities" aria-labelledby="activities-title">
      <div class="section-heading" data-reveal>
        <div>
          <p class="hw-eyebrow">日常</p>
          <h2 id="activities-title">我们在做什么</h2>
        </div>
        <a href="#join">加入我们 →</a>
      </div>

      <div class="list-rows" data-reveal style="--reveal-delay: 80ms">
        {
          activities.map((item) => (
            <div class="list-row">
              <span class="list-row-index">{item.index}</span>
              <div>
                <h3 class="list-row-title">{item.title}</h3>
                <p class="list-row-text">{item.text}</p>
              </div>
              <div class="list-row-meta">
                <span>{item.meta}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="section-heading" data-reveal>
        <div>
          <p class="hw-eyebrow">组织信息</p>
          <h2 id="about-title">先了解，再决定</h2>
        </div>
      </div>

      <div class="hw-grid">
        <div class="hw-span-7 panel" data-reveal>
          <p class="hw-label">概况</p>
          <dl class="meta-list">
            <div>
              <dt>服务器</dt>
              <dd>Minecraft Java 版</dd>
            </div>
            <div>
              <dt>玩法</dt>
              <dd>原版生存</dd>
            </div>
            <div>
              <dt>规模</dt>
              <dd>小队，保持人少</dd>
            </div>
            <div>
              <dt>活动时间</dt>
              <dd>晚间与周末为主</dd>
            </div>
            <div>
              <dt>加入方式</dt>
              <dd>填写申请，再聊一次</dd>
            </div>
          </dl>
        </div>

        <div class="hw-span-5 panel" data-reveal style="--reveal-delay: 80ms">
          <p class="hw-label">我们看重什么</p>
          <h3>稳定，比热闹重要</h3>
          <p class="panel-text">
            云栖深处不是速通队，也不追求人数。我们更在意一个存档能不能放上几年，
            以及上线的时候，还有人愿意一起把没盖完的屋顶盖完。
          </p>
          <ul class="rule-list">
            <li>愿意长期玩，而不是来转一圈。</li>
            <li>喜欢合作，也能自己找事做。</li>
            <li>尊重别人的建筑和节奏。</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" id="rules" aria-labelledby="rules-title">
      <div class="section-heading" data-reveal>
        <div>
          <p class="hw-eyebrow">约定</p>
          <h2 id="rules-title">几条说好的事</h2>
        </div>
      </div>

      <div class="list-rows" data-reveal>
        {
          rules.map((item) => (
            <div class="list-row">
              <span class="list-row-index">{item.index}</span>
              <div>
                <h3 class="list-row-title">{item.title}</h3>
                <p class="list-row-text">{item.text}</p>
              </div>
            </div>
          ))
        }
      </div>

      <p class="notice rules-notice" data-reveal>
        <strong>没有写进约定的部分：</strong>交给常识。管理员不会随时在线，
        遇到问题先在群里说，别自己憋着，也别自己动手拆。
      </p>
    </section>

    <section class="section" id="join" aria-labelledby="join-title">
      <div class="section-heading" data-reveal>
        <div>
          <p class="hw-eyebrow">加入</p>
          <h2 id="join-title">写几句话，让我们认识你</h2>
        </div>
      </div>

      <div class="hw-grid">
        <div class="hw-span-7 panel" data-reveal>
          <p class="hw-label">加入申请</p>
          <form class="form-stack" data-join-form>
            <label class="field">
              <span>游戏 ID</span>
              <input
                type="text"
                name="player"
                autocomplete="username"
                placeholder="你的 Minecraft ID"
                required
              />
            </label>
            <label class="field">
              <span>怎么称呼你</span>
              <input
                type="text"
                name="nickname"
                autocomplete="nickname"
                placeholder="昵称或常用称呼"
              />
            </label>
            <label class="field">
              <span>联系方式</span>
              <input
                type="text"
                name="contact"
                placeholder="QQ / Discord / 邮箱，任选其一"
              />
              <span class="field-hint">只用于联系你，不会公开。</span>
            </label>
            <label class="field">
              <span>想在这里做什么</span>
              <textarea
                name="plan"
                rows="3"
                placeholder="比如：想盖房子、想跑图、想弄红石，或者只是来找人一起玩"
              ></textarea>
            </label>
            <div class="form-actions">
              <button class="filled-tonal-button" type="submit">提交申请</button>
              <p class="form-status" role="status" aria-live="polite" data-join-status></p>
            </div>
          </form>
        </div>

        <div class="hw-span-5 panel" data-reveal style="--reveal-delay: 80ms">
          <p class="hw-label">接下来</p>
          <h3>提交之后</h3>
          <ol class="step-list">
            <li>
              <span class="step-index">01</span>
              <span>管理员看到申请，会在几天内联系你。</span>
            </li>
            <li>
              <span class="step-index">02</span>
              <span>简单聊几句：玩多久、喜欢做什么、想住在哪片。</span>
            </li>
            <li>
              <span class="step-index">03</span>
              <span>拉你进群，给你划一块地，剩下的慢慢来。</span>
            </li>
          </ol>
          <p class="notice">
            <strong>说明：</strong>这个表单目前只是页面演示，还没有接后端。
            正式开放时再换成真实提交地址。
          </p>
        </div>
      </div>
    </section>
  </div>

  <section class="join-band" aria-labelledby="band-title">
    <div class="hw-shell">
      <p class="hw-eyebrow">开始</p>
      <h2 id="band-title">屋顶还没盖完，来搭一手？</h2>
      <p>不需要作品集，也不用先练技术。带上你的 ID 就够了。</p>
      <a class="filled-button" href="#join">申请加入</a>
    </div>
  </section>

  <div class="hw-shell">
    <footer class="page-foot">
      <p>云栖深处 · CloudHaven</p>
      <a href="#main">回到顶部 ↑</a>
    </footer>
  </div>
</BaseLayout>

<script>
  const joinForm = document.querySelector<HTMLFormElement>('[data-join-form]');
  const joinStatus = document.querySelector<HTMLElement>('[data-join-status]');

  joinForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!joinStatus) return;

    const player = new FormData(joinForm).get('player');
    const filled = typeof player === 'string' && player.trim().length > 0;

    joinStatus.textContent = filled
      ? '已记录（演示，尚未接入后端）'
      : '请先填写游戏 ID。';

    if (filled) {
      joinStatus.dataset.tone = 'ok';
    } else {
      delete joinStatus.dataset.tone;
    }
  });
</script>

<style>
  .hero-plate {
    margin-block: var(--hw-space-5) var(--hw-space-7);
  }

  .hero-title {
    font-size: var(--md-sys-typescale-headline-large-size);
    letter-spacing: -0.035em;
  }

  .theme-icon-sun {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-icon-moon {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-icon-sun {
    display: block;
  }

  .panel-text {
    margin-top: var(--hw-space-3);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.7;
  }

  .rule-list {
    display: grid;
    gap: var(--hw-space-2);
    margin-top: var(--hw-space-4);
  }

  .rule-list li {
    position: relative;
    padding-left: var(--hw-space-5);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.7;
  }

  .rule-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: var(--hw-space-2);
    height: 1px;
    background: var(--md-sys-color-primary);
  }

  .rules-notice {
    margin-top: var(--hw-space-5);
  }

  .step-list {
    display: grid;
    gap: var(--hw-space-4);
    margin-top: var(--hw-space-4);
  }

  .step-list li {
    display: flex;
    align-items: baseline;
    gap: var(--hw-space-3);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.7;
  }

  .step-index {
    color: var(--md-sys-color-primary);
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hw-space-3);
  }

  .page-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--hw-space-3);
    padding-block: var(--hw-space-5) var(--hw-space-6);
    border-top: 1px solid var(--md-sys-color-outline-variant);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-label-medium-size);
  }

  .page-foot a {
    color: var(--md-sys-color-primary);
    font-weight: 600;
  }

  /* 收尾主色场：整幅铺开，只在这一屏出现 */
  .join-band {
    margin-top: clamp(56px, 8vw, 112px);
    padding-block: clamp(56px, 8vw, 104px);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  /* 色块之后还要放页脚，靠内边距收住，不再叠 margin */
  .join-band + .hw-shell .page-foot {
    border-top: 0;
  }

  .join-band h2 {
    max-width: 20em;
    margin-top: var(--hw-space-3);
    font-size: var(--md-sys-typescale-headline-large-size);
    letter-spacing: -0.035em;
  }

  .join-band p:not(.hw-eyebrow) {
    max-width: 40ch;
    margin-top: var(--hw-space-4);
    font-size: var(--md-sys-typescale-body-large-size);
    line-height: 1.8;
  }

  .join-band .filled-button {
    margin-top: var(--hw-space-5);
  }
</style>
